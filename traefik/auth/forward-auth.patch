+// CookieExpires returns the expiry time stored in an auth cookie. The cookie
+// must have been validated with ValidateCookie before.
+func CookieExpires(c *http.Cookie) (time.Time, error) {
+	parts := strings.Split(c.Value, "|")
+	if len(parts) != 3 {
+		return time.Time{}, errors.New("Invalid cookie format")
+	}
+	expires, err := strconv.ParseInt(parts[1], 10, 64)
+	if err != nil {
+		return time.Time{}, errors.New("Unable to parse cookie expiry")
+	}
+	return time.Unix(expires, 0), nil
+}
