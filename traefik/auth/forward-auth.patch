+func TestServerAuthHandlerRenewsCookie(t *testing.T) {
+	assert := assert.New(t)
+	config = newDefaultConfig()
+	config.Domains = []string{}
+
+	// Fresh cookie should not be renewed
+	req := newHTTPRequest("GET", "http://example.com/foo")
+	res, _ := doHttpRequest(req, MakeCookie(req, "test@example.com"))
+	assert.Equal(200, res.StatusCode, "valid request should be allowed")
+	// (doHttpRequest puts the request cookie on the recorder as first cookie)
+	assert.Len(res.Cookies()[1:], 0, "fresh cookie should not be renewed")
+
+	// Cookie with less than half of its lifetime left should be renewed
+	config.Lifetime = time.Hour
+	req = newHTTPRequest("GET", "http://example.com/foo")
+	c := MakeCookie(req, "test@example.com")
+	config.Lifetime = time.Hour * 24
+	res, _ = doHttpRequest(req, c)
+	assert.Equal(200, res.StatusCode, "valid request should be allowed")
+	cookies := res.Cookies()[1:]
+	if assert.Len(cookies, 1, "old cookie should be renewed") {
+		assert.Equal(config.CookieName, cookies[0].Name)
+		assert.True(cookies[0].Expires.After(time.Now().Add(time.Hour*23)), "renewed cookie should get full lifetime")
+		_, err := ValidateCookie(req, cookies[0])
+		assert.Nil(err, "renewed cookie should be valid")
+	}
+}
